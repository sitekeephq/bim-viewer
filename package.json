{
  "name": "@7dimensions-project/bim-viewer",
  "version": "0.3.0",
  "description": "Shared BIM viewer engine and React integration for 7Dimensions products",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7Dimensions-Project/7dimensions-bim-viewer.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./styles.css": "./styles.css",
    "./tools.css": "./tools.css",
    "./copy-assets": "./scripts/copy-assets.mjs",
    "./scan": {
      "types": "./dist/scan/index.d.ts",
      "import": "./dist/scan/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/copy-assets.mjs",
    "styles.css",
    "tools.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "3.4.8",
    "camera-controls": "3.1.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "3.4.8",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "camera-controls": "3.1.2",
    "three": "0.186.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
