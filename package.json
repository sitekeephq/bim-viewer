{
  "name": "@7dimensions/bim-viewer",
  "version": "0.1.0",
  "description": "Shared BIM viewer engine and React integration for 7Dimensions products",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "scripts/copy-assets.mjs",
    "styles.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "3.4.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "3.4.8",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  }
}
